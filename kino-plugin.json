{
  "id": "cinehax-plus",
  "name": "CineHax+",
  "creator": "JuandreXter",
  "version": "0.3.8",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Creado por JuandreXter - Películas y series en español latino de CineHax+",
  "homepage": "https://cinehaxplus.com",
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "normalizeHost"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "hosts": [
    "cinehaxplus.com",
    "*.cinehaxplus.com",
    "api-encrypted.moviemaster.lat"
  ],
  "streamHosts": "any",
  "browser": true,
  "telemetry": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "section": {
    "label": "CineHax+"
  },
  "theme": {
    "accent": "#2563EB",
    "onAccent": "#FFFFFF",
    "background": "#0B0C14",
    "surface": "#1B1F2E",
    "highlight": "#6EE7A8"
  },
  "settings": [
    {
      "key": "seccion",
      "label": "Sección y categorías",
      "type": "section"
    },
    {
      "key": "pestanas",
      "label": "Pestañas",
      "type": "select",
      "hint": "Qué pestañas y categorías muestra Kino",
      "options": [
        {
          "value": "ambas",
          "label": "Películas y series"
        },
        {
          "value": "peliculas",
          "label": "Solo películas"
        },
        {
          "value": "series",
          "label": "Solo series"
        }
      ],
      "default": "ambas"
    },
    {
      "key": "sitio",
      "label": "Sitio",
      "type": "section"
    },
    {
      "key": "estado",
      "label": "Estado",
      "type": "status"
    },
    {
      "key": "comprobar",
      "label": "Comprobar que el sitio responde",
      "type": "action"
    },
    {
      "key": "limpiar",
      "label": "Borrar la caché",
      "type": "action",
      "confirm": "¿Borrar la caché de búsquedas y temporadas?"
    }
  ],
  "signature": {
    "authorKey": "0036d8031405ef39f52a4c120617f46a8db166fa23867367f7ae68360f7e31cd",
    "value": "ec73ae95ebf9ec7a958289997692d0e751567f8a8aea3942d19689826813f8cf2c154992184adb0c0f0f472b2c5a53afa74d099a1c914991dc6ec1a654c20e0e"
  }
}
