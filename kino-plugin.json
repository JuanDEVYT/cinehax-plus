{
  "id": "cinehax-plus",
  "name": "CineHax+",
  "creator": "JuandreXter",
  "version": "0.8.2",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Creado por JuandreXter - Películas y series en español latino de CineHax+",
  "homepage": "https://cinehaxplus.com",
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "normalizeHost",
        "rank"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "hosts": [
    "cinehaxplus.com",
    "*.cinehaxplus.com",
    "api-encrypted.moviemaster.lat"
  ],
  "streamHosts": "any",
  "browser": true,
  "telemetry": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "screen"
  ],
  "screen": {
    "label": "CineHax+",
    "labelEn": "CineHax+",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir CineHax+",
      "labelEn": "Open CineHax+"
    }
  },
  "section": {
    "label": "CineHax+"
  },
  "panel": {
    "label": "CineHax+",
    "labelEn": "CineHax+"
  },
  "theme": {
    "accent": "#2563EB",
    "onAccent": "#FFFFFF",
    "background": "#0B0C14",
    "surface": "#1B1F2E",
    "highlight": "#6EE7A8"
  },
  "settings": [
    {
      "key": "seccion",
      "label": "Sección y categorías",
      "type": "section"
    },
    {
      "key": "pestanas",
      "label": "Pestañas",
      "type": "select",
      "hint": "Qué pestañas y categorías muestra Kino",
      "options": [
        {
          "value": "ambas",
          "label": "Películas y series"
        },
        {
          "value": "peliculas",
          "label": "Solo películas"
        },
        {
          "value": "series",
          "label": "Solo series"
        }
      ],
      "default": "ambas"
    },
    {
      "key": "idioma",
      "label": "Idioma preferido",
      "type": "select",
      "hint": "Qué copia se prueba primero cuando el reproductor ofrece varias",
      "options": [
        {
          "value": "auto",
          "label": "Automático"
        },
        {
          "value": "lat",
          "label": "Latino"
        },
        {
          "value": "cast",
          "label": "Castellano"
        },
        {
          "value": "sub",
          "label": "Subtitulado"
        }
      ],
      "default": "auto"
    },
    {
      "key": "sitio",
      "label": "Sitio",
      "type": "section"
    },
    {
      "key": "estado",
      "label": "Estado",
      "type": "status"
    },
    {
      "key": "comprobar",
      "label": "Comprobar que el sitio responde",
      "type": "action"
    },
    {
      "key": "limpiar",
      "label": "Borrar la caché",
      "type": "action",
      "confirm": "¿Borrar la caché de búsquedas y temporadas?"
    }
  ],
  "signature": {
    "authorKey": "0036d8031405ef39f52a4c120617f46a8db166fa23867367f7ae68360f7e31cd",
    "value": "72d888e8aaff367da4965903291aa4bc32018625d74e7cf38098dfcfb04d332f66350d85fd5d487cbd747d1265ab75e4aa9be097744123c2d2f2d7605a72b302"
  }
}
